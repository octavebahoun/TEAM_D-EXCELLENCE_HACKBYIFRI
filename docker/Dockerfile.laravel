# ============================================================
# STAGE 1: Dépendances vendor (Composer)
# ============================================================
FROM composer:2 AS vendor

WORKDIR /app

COPY backend/laravel/composer.json backend/laravel/composer.lock* ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-plugins \
    --no-scripts \
    --prefer-dist

# ============================================================
# STAGE 2: Build application (extensions + caching Artisan)
# ============================================================
FROM php:8.4-fpm-alpine AS builder

WORKDIR /app

# Dépendances virtuelles temporaires pour la compilation
# Supprimées à la fin du RUN pour image légère
RUN apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    linux-headers \
    oniguruma-dev \
    icu-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    && docker-php-ext-configure gd \
       --with-freetype=/usr/include/ \
       --with-jpeg=/usr/include/ \
    && docker-php-ext-install -j$(nproc) \
       pdo_mysql mbstring intl zip bcmath gd opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps \
    && rm -rf /tmp/pear ~/.pearrc

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Vendor
COPY --from=vendor /app/vendor ./vendor

# Code source
COPY backend/laravel .

# Dossiers requis par Laravel avant toute opération Artisan
RUN mkdir -p bootstrap/cache \
    storage/framework/cache/data \
    storage/framework/views \
    storage/framework/sessions \
    storage/logs \
    && chmod -R 775 bootstrap/cache storage

# Optimisations Laravel
RUN composer dump-autoload --optimize \
    && php artisan config:cache \
    && php artisan route:cache \
    && php artisan view:cache

# ============================================================
# STAGE 3: Production PHP-FPM + Nginx
# ============================================================
FROM php:8.4-fpm-alpine AS production

# Paquets runtime système
RUN apk add --no-cache nginx supervisor curl

# Construction des extensions PHP avec dépendances virtuelles
# .build-deps = outils de compilation (supprimés après)
# .run-deps  = librairies partagées nécessaires au runtime (conservées)
RUN apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    linux-headers \
    oniguruma-dev \
    icu-dev \
    libzip-dev \
    && docker-php-ext-install -j$(nproc) \
       pdo_mysql mbstring intl zip bcmath opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && runDeps="$( \
         scanelf --needed --nobanner --format '%n#p' --recursive /usr/local \
         | tr ',' '\n' \
         | sort -u \
         | awk 'system("[ -e /usr/local/lib/" $1 " ]") == 0 { next } { print "so:" $1 }' \
       )" \
    && apk add --no-cache --virtual .run-deps $runDeps \
    && apk del .build-deps \
    && rm -rf /tmp/pear ~/.pearrc

# Configuration PHP optimisée
RUN { \
    echo 'memory_limit = 256M'; \
    echo 'upload_max_filesize = 20M'; \
    echo 'post_max_size = 25M'; \
    echo 'max_execution_time = 300'; \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=64'; \
    echo 'opcache.interned_strings_buffer=8'; \
    echo 'opcache.max_accelerated_files=4000'; \
    } > /usr/local/etc/php/conf.d/academix.ini

WORKDIR /var/www/html

COPY --from=builder /app .

COPY docker/nginx/default.conf /etc/nginx/http.d/default.conf

RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
