# ================================================================
# AcademiX - Variables d'environnement Docker
# Copier ce fichier en .env et remplir les valeurs
# ================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
DB_NAME=academix
DB_USER=academix_user
DB_PASSWORD=CHANGE_ME_db_password
MYSQL_PORT=3306

# --- MongoDB ---
MONGO_PORT=27017

# --- Redis ---
REDIS_PORT=6379

# --- Laravel ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
LARAVEL_PORT=8000

# --- Node.js ---
NODE_PORT=3001
FRONTEND_URL=https://your-domain.com
PUBLIC_BASE_URL=https://node.your-domain.com

# --- Python IA ---
PYTHON_PORT=5000

# --- Clés API IA (OBLIGATOIRE) ---
GROQ_API_KEY=gsk_xxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxx
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-thinking:free

# --- Sécurité ---
WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# --- Google Calendar/Tasks (optionnel) ---
GOOGLE_CLIENT_ID=xxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxx
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# --- VAPID Web Push (optionnel) ---
VAPID_PUBLIC_KEY=xxxxxxx
VAPID_PRIVATE_KEY=xxxxxxx
VAPID_SUBJECT=mailto:contact@academix.app

# --- KAVT Assistant IA (optionnel) ---
KAVT_ENABLED=true
KAVT_MODEL=arcee-ai/trinity-large-preview:free
