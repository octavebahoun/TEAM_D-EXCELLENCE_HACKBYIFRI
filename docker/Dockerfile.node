# ============================================================
# ÉTAPE 1 : Installation des dépendances
# ============================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Dépendances système pour native modules (bcrypt, etc.)
RUN apk add --no-cache python3 make g++

COPY backend/node/package.json backend/node/package-lock.json* ./
RUN npm ci --omit=dev

# ============================================================
# ÉTAPE 2 : Image de production
# ============================================================
FROM node:22-alpine AS production

RUN apk add --no-cache tini curl

WORKDIR /app

# Dépendances runtime uniquement (sans les outils de build)
COPY --from=builder /app/node_modules ./node_modules
COPY backend/node/package.json ./
COPY backend/node/src ./src

# Dossier uploads
RUN mkdir -p uploads/chat && chown -R node:node /app

USER node

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3001/health || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "src/server.js"]
