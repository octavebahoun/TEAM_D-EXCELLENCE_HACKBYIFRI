# ================================================================
#  AcademiX - Guide des Variables d'Environnement
# ================================================================
#  Copier ce fichier :  cp .env.example .env
#  Puis éditer avec :   nano .env
#
#  Légende :
#    [OBLIGATOIRE]  = Le service ne démarre pas sans
#    [RECOMMANDÉ]   = Fonctionne sans, mais feature dégradée
#    [OPTIONNEL]    = Peut rester vide, feature désactivée
# ================================================================


# ================================================================
#  1. MySQL (Base de données principale)
# ================================================================

# [OBLIGATOIRE] Mot de passe root MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

# [OBLIGATOIRE] Base de données
DB_NAME=academix

# [OBLIGATOIRE] Utilisateur MySQL (doit correspondre à DB_USERNAME côté Laravel)
DB_USER=academix_user

# [OBLIGATOIRE] Mot de passe utilisateur MySQL
DB_PASSWORD=CHANGE_ME_db_password

# Port MySQL exposé (laisser 3306 si pas de conflit)
MYSQL_PORT=3306


# ================================================================
#  2. MongoDB (Temps réel : chat, sessions, notifications)
# ================================================================

# Port MongoDB exposé
MONGO_PORT=27017


# ================================================================
#  3. Redis (Cache Laravel uniquement)
# ================================================================

# Port Redis exposé
REDIS_PORT=6379


# ================================================================
#  4. Laravel API (Backend principal)
# ================================================================

# [OBLIGATOIRE] URL publique de l'app (pour Google OAuth, emails, etc.)
APP_URL=https://ton-domaine.com

# Port Laravel exposé
LARAVEL_PORT=8000


# ================================================================
#  5. Node.js (WebSocket + Messagerie temps réel)
# ================================================================

# Port Node.js exposé
NODE_PORT=3001

# [RECOMMANDÉ] URL du frontend pour CORS
FRONTEND_URL=https://ton-domaine.com

# [OPTIONNEL] URL publique du Node.js (pour fichiers uploadés)
# PUBLIC_BASE_URL=https://ton-node.onrender.com


# ================================================================
#  6. Python IA (FastAPI)
# ================================================================

# Port Python exposé
PYTHON_PORT=5000


# ================================================================
#  7. Clés API Intelligence Artificielle
# ================================================================

# [OBLIGATOIRE] Clé API Groq (résumés, quiz, exercices, podcasts, analyse)
# Obtenir sur : https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# [RECOMMANDÉ] Clé API OpenRouter (images IA + assistant KAVT dans les sessions)
# Obtenir sur : https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Modèle OpenRouter par défaut (laisser tel quel sauf cas spécial)
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-thinking:free


# ================================================================
#  8. Sécurité inter-services
# ================================================================

# [RECOMMANDÉ] Secret pour les webhooks Laravel → Node.js
# Générer un secret : openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_webhook_secret


# ================================================================
#  9. Google Calendar / Tasks (optionnel)
# ================================================================
#  Pour synchroniser les emplois du temps vers Google Calendar.
#  Créer un projet sur : https://console.cloud.google.com
#  Activer : Google Calendar API + Google Tasks API
#  Créer des credentials OAuth 2.0

# [OPTIONNEL] Client ID Google
GOOGLE_CLIENT_ID=

# [OPTIONNEL] Client Secret Google
GOOGLE_CLIENT_SECRET=

# [OPTIONNEL] URI de redirection (doit correspondre à Google Cloud Console)
# En prod : https://ton-domaine.com/auth/google/callback
# En dev  : http://localhost:5173/auth/google/callback
GOOGLE_REDIRECT_URI=https://ton-domaine.com/auth/google/callback


# ================================================================
#  10. VAPID - Web Push Notifications (optionnel)
# ================================================================
#  Générer les clés : npx web-push generate-vapid-keys
#  La VITE_VAPID_PUBLIC_KEY côté Vercel doit correspondre à VAPID_PUBLIC_KEY ici

# [OPTIONNEL] Clé publique VAPID
VAPID_PUBLIC_KEY=

# [OPTIONNEL] Clé privée VAPID (JAMAIS côté frontend)
VAPID_PRIVATE_KEY=

# [OPTIONNEL] Contact pour les notifications push
VAPID_SUBJECT=mailto:contact@academix.app


# ================================================================
#  11. KAVT - Assistant IA dans les sessions (optionnel)
# ================================================================
#  L'assistant IA répond aux messages @kavt dans les sessions collaboratives.
#  Nécessite OPENROUTER_API_KEY ci-dessus.

# Activer/désactiver l'assistant (true/false)
KAVT_ENABLED=true

# Modèle IA pour KAVT
KAVT_MODEL=arcee-ai/trinity-large-preview:free
