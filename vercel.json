{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "ignore": ["backend", "python", "docs", "tests"],
  "rewrites": [
    {
      "source": "/api/laravel/:path*",
      "destination": "https://academix-production-bfde.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/api/node/:path*",
      "destination": "https://team-d-excellence-hackbyifri-2026.onrender.com/api/:path*"
    },
    {
      "source": "/api/python/:path*",
      "destination": "https://academix-production-dd5f.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://team-d-excellence-hackbyifri-2026.onrender.com/socket.io"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://team-d-excellence-hackbyifri-2026.onrender.com/socket.io/:path*"
    },
    {
      "source": "/((?!api|socket.io).*)",
      "destination": "/index.html"
    }
  ]
}
