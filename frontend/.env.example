# URLs des APIs backend
# En dev : le proxy Vite redirige /api/* vers localhost:8000
# En prod (Vercel) : les rewrites dans vercel.json gèrent la redirection
# Ne pas définir ces variables sauf besoin de pointer directement vers un backend
# VITE_LARAVEL_API_URL=/api/laravel
# VITE_NODE_API_URL=/api/node
# VITE_PYTHON_API_URL=/api/python

# URL du serveur Socket.IO (OBLIGATOIRE sur Vercel)
# Doit pointer vers le reverse-proxy HTTPS Caddy (PAS l'IP:3001 en clair).
# socket.io-client passe automatiquement en wss:// à partir d'une URL https://
VITE_SOCKET_URL=https://52-47-71-184.sslip.io

# Clé publique VAPID (Push Notifications)
# Doit correspondre à VAPID_PUBLIC_KEY dans le .env Laravel
# Générer avec : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
