{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/laravel/:path*",
      "destination": "http://13.36.171.214:8000/api/v1/:path*"
    },
    {
      "source": "/api/node/:path*",
      "destination": "http://13.36.171.214:3001/api/:path*"
    },
    {
      "source": "/api/python/:path*",
      "destination": "http://13.36.171.214:5000/api/v1/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "http://13.36.171.214:3001/socket.io"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "http://13.36.171.214:3001/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
