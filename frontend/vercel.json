{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/laravel/:path*",
      "destination": "https://acadmix-serveur.duckdns.org/api/laravel/:path*"
    },
    {
      "source": "/api/node/:path*",
      "destination": "https://acadmix-serveur.duckdns.org/api/node/:path*"
    },
    {
      "source": "/api/python/:path*",
      "destination": "https://acadmix-serveur.duckdns.org/api/python/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://acadmix-serveur.duckdns.org/socket.io"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://acadmix-serveur.duckdns.org/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
